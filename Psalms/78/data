\c 78
\s Sejarah perjanjian TUHAN dengan umat-Nya
\d Lagu pengajaran, oleh Asaf.
\q1
\v 1 Hai jemaat sekalian,
\q1 dengarkanlah pengajaranku.
\q1 Perhatikanlah baik-baik perkataanku.
\q1
\v 2 Aku akan menyampaikan pepatah
\q1 dan menyingkapkan pengetahuan yang dirahasiakan sejak awal zaman.
\q3
\v 3 Pengajaran ini sudah kita dengar dan ketahui
\q3 dari orang tua dan kakek nenek kita,
\q3
\v 4 dan kita pun meneruskannya kepada anak cucu kita.
\q3 Akan kita ceritakan dari generasi ke generasi
\q3 bahwa TUHAN sangat terpuji
\q3 karena kuasa-Nya dahsyat dan perbuatan-perbuatan-Nya ajaib!
\q1
\v 5 TUHAN telah menetapkan hukum Taurat bagi Israel,
\q1 bangsa keturunan Yakub.
\q1 Di dalamnya, TUHAN menugaskan setiap orang tua
\q1 untuk mengajarkan hukum itu kepada anak mereka masing-masing\x + \xo 78:5 \xt Kel 12:26-27; Kel 13:14-15; Ul 6:6-7; Ul 11:19\x*
\q1
\v 6 agar anak-anak itu kelak mengajarkannya lagi
\q1 kepada generasi selanjutnya yang akan lahir.
\q1 Begitulah seterusnya dari zaman ke zaman,
\q1
\v 7 agar setiap generasi tidak melupakan segala perbuatan Allah,
\q1 melainkan bergantung penuh kepada-Nya
\q1 dan menaati perintah-perintah-Nya.
\q3
\v 8 Dengan begitu,
\q3 mereka tidak akan seperti nenek moyang Israel yang keluar dari Mesir,
\q3 yang hatinya tidak setia kepada Allah,
\q3 dan terus memberontak kepada-Nya.
\b
\q1
\v 9 Misalnya suku Efraim yang tidak taat dalam peperangan.
\q1 Mereka sudah menyandang busur dan panah,
\q1 tetapi kabur pada hari pertempuran.
\q1
\v 10 Mereka tidak menepati perjanjian dengan Allah
\q1 dan menolak taat kepada Taurat-Nya.
\q1
\v 11 Mereka melupakan perbuatan ajaib TUHAN
\q1 yang sudah ditunjukkan-Nya kepada mereka.
\b
\q3
\v 12 TUHAN melakukan perbuatan-perbuatan luar biasa
\q3 di depan mata orang tua mereka
\q3 sewaktu mereka masih tinggal di padang Zoan di negeri Mesir.
\q3
\v 13 Dia membelah air Laut Merah
\q3 menjadi seperti tembok di kanan kiri mereka
\q3 sehingga mereka bisa berjalan lewat di tengah-tengahnya.
\q3
\v 14 Dipimpin-Nya mereka dengan tiang awan sepanjang siang
\q3 dan dengan tiang api sepanjang malam.
\q3
\v 15 Di padang belantara Dia membelah batu
\q3 dan mengeluarkan air berlimpah-limpah bagai laut
\q3 demi memberi minum nenek moyang kita.
\q3
\v 16 Dia membuat air itu keluar dari batu
\q3 sampai mengalir deras seperti sungai.
\b
\q1
\v 17 Tetapi nenek moyang kita terus saja berdosa kepada Yang Mahatinggi.
\q1 Di padang belantara mereka memberontak terhadap-Nya.
\q1
\v 18 Mereka sengaja menguji kemampuan Allah
\q1 dengan menuntut diberi makanan yang mereka inginkan.
\q1
\v 19 Mereka menghina Allah dengan berkata,
\q1 “Apa mungkin Allah bisa menyediakan makanan di padang belantara ini?
\q1
\v 20 Memang Dia sudah membelah batu sehingga ada air mengalir,
\q1 tetapi coba berikan juga roti dan daging untuk umat-Nya!”
\q3
\v 21 Mendengar semuanya itu,
\q3 marahlah TUHAN
\q3 sehingga api murka-Nya membakar Israel
\q3
\v 22 karena mereka tidak percaya kepada Allah
\q3 dan tidak yakin bahwa Dia akan menolong.
\q1
\v 23 Namun, Allah memberi perintah
\q1 sehingga langit terbuka bagaikan pintu.
\q1
\v 24 Lalu turunlah manna\x + \xo 78:24 \xt Kel 16:31\x* seperti hujan.
\q1 Demikianlah Allah memberi mereka makanan dari surga.
\q1
\v 25 Betapa ajaib,
\q1 manusia pernah diizinkan memakan makanan malaikat,
\q1 bahkan Allah memberikannya kepada mereka berlimpah-limpah.
\q3
\v 26 Kemudian dengan kuasa-Nya,
\q3 Allah membuat angin besar bertiup dari timur dan dari selatan
\q3
\v 27 menerbangkan burung-burung sebanyak pasir di pantai.
\q3 Dengan angin itu,
\q3 Allah menurunkan daging seperti hujan bagi mereka.
\q3
\v 28 Dia membuat burung-burung itu terdampar
\q3 di tengah perkemahan nenek moyang kita,
\q3 di sekeliling tempat tinggal mereka.
\q3
\v 29 Maka mereka mengolah daging burung
\q3 dan makan sampai kenyang.
\q3 Allah mengabulkan keinginan mereka.
\q1
\v 30 Akan tetapi, sebelum mereka puas mengikuti hawa nafsu,\x + \xo 78:30 \xt Bil 11:34\x*
\q1 sementara mulut mereka masih mengunyah,
\q1
\v 31 murka Allah menimpa mereka!
\q1 Dia mematikan pemuda-pemuda Israel yang terkuat.
\b
\q1
\v 32 Namun setelah semuanya itu,
\q1 nenek moyang kita masih terus berdosa.
\q1 Mereka tetap tidak percaya penuh kepada Allah
\q1 walaupun Dia sudah melakukan banyak perbuatan ajaib.
\q1
\v 33 Dan Dia membuat hidup mereka berakhir dengan sia-sia.
\q3
\v 34 Orang-orang itu membuat Allah murka
\q3 sehingga Dia mematikan sebagian dari mereka.
\q3 Lalu mereka bertobat dan berbalik mencari Allah.
\q3
\v 35 Mereka mengingat bahwa Allah Yang Mahatinggi adalah penebus.
\q3 Dialah penjaga mereka seperti gunung batu tempat perlindungan.
\q3
\v 36 Namun, pertobatan dan pujian mereka hanya omong kosong,
\q3
\v 37 karena sesungguhnya hati mereka tidak setia kepada Allah
\q3 dan mereka melanggar ikatan perjanjian-Nya.
\q1
\v 38 Tetapi karena Allah murah hati,
\q1 Dia mengampuni dan tidak memusnahkan mereka.
\q1 Bahkan berkali-kali Allah memadamkan amarah-Nya
\q1 dan tidak menimpakan murka-Nya kepada mereka.
\q1
\v 39 Dia tahu bahwa mereka hanya manusia belaka
\q1 yang hidupnya hanya sementara,
\q1 bagaikan angin lewat kemudian lenyap.
\b
\q3
\v 40 Betapa seringnya mereka memberontak terhadap Allah
\q3 dan mendukakan hati-Nya di padang belantara.
\q3
\v 41 Berkali-kali mereka menguji Sang Mahakudus Allah Israel
\q3 sehingga membangkitkan amarah-Nya.
\q3
\v 42 Mereka lupa akan kuasa-Nya yang besar
\q3 ketika Dia menebus mereka dari musuh.
\q1
\v 43 Mereka tidak mengingat
\q1 betapa Allah mengadakan tanda-tanda ajaib
\q1 di padang Zoan di negeri Mesir.
\q1
\v 44 Dia mengubah sungai-sungai dan semua air menjadi darah
\q1 sehingga orang-orang Mesir tidak dapat minum.
\q1
\v 45 Dia mendatangkan serbuan lalat
\q1 mengerubungi seluruh penduduk negeri
\q1 dan serangan katak menyusahkan hidup mereka.
\q1
\v 46 Allah juga mengirim belalang yang melahap semua tanaman
\q1 dan membuat seluruh negeri gagal panen.
\q1
\v 47 Dia menurunkan hujan es
\q1 menghancurkan kebun-kebun anggur dan pohon-pohon ara.
\q1
\v 48 Hewan-hewan ternak orang Mesir juga mati
\q1 dilanda hujan es dan sambaran petir.
\q3
\v 49 Allah menimpakan kepada Mesir
\q3 gelora murka-Nya yang sangat dahsyat
\q3 berupa hantaman malapetaka bertubi-tubi
\q3 seperti serangan malaikat-malaikat penghancur.
\q3
\v 50 Dia mengobarkan murka-Nya dengan kekuatan penuh.
\q3 Dikirim-Nya wabah penyakit menewaskan banyak orang Mesir.
\q3 Allah tidak meluputkan nyawa mereka dari maut.
\q1
\v 51 Terakhir, Dia mematikan semua anak sulung orang Mesir.
\q1 Anak-anak andalan bangsa keturunan Ham pun habis binasa.
\q1
\v 52 Lalu Allah memimpin umat-Nya keluar dari Mesir
\q1 seperti gembala menuntun kawanan dombanya.
\q1 Dia membimbing mereka melintasi padang belantara.
\q1
\v 53 Umat-Nya dibawa dengan aman sehingga mereka tidak takut.
\q1 Musuh-musuh mereka ditenggelamkan ke laut.
\q1
\v 54 Diantar-Nya mereka ke Kanaan, negeri pilihan-Nya,
\q1 negeri berbukit yang telah direbut Allah dengan kuasa-Nya.
\q1
\v 55 Allah mengusir bangsa-bangsa Kanaan
\q1 sehingga mereka lari bahkan sebelum pasukan umat-Nya menyerang.
\q1 Dia membagi-bagi negeri itu kepada suku-suku Israel
\q1 sehingga setiap keluarga menempati rumah dan tanah warisan
\q1 yang menjadi milik mereka turun-temurun.
\b
\q3
\v 56 Namun, lagi-lagi orang Israel memberontak
\q3 terhadap Allah Yang Mahatinggi.
\q3 Mereka menguji Dia dan melanggar hukum-hukum-Nya.
\q3
\v 57 Seperti generasi sebelumnya,
\q3 mereka meninggalkan Allah dan tidak setia kepada-Nya.
\q3 Seperti busur panah yang bengkok
\q3 tak dapat diandalkan untuk menembak lurus,
\q3 demikianlah mereka itu serong dan tak dapat berbuat benar.
\q3
\v 58 Mereka menyembah berhala di puncak-puncak bukit
\q3 hingga menyulut kecemburuan dan murka Allah.
\q1
\v 59 Ketika melihatnya, marahlah Allah
\q1 dan menganggap jijik Israel.
\q1
\v 60 Maka Dia pergi dari kemah-Nya di Silo
\q1 dan tak mau lagi tinggal di tengah umat itu.
\q1
\v 61 Dia membiarkan musuh Israel merampas peti perjanjian\x + \xo 78:61 \xt 1Sam 4:1-11\x*
\q1 yang adalah lambang kuasa dan kemuliaan Allah.
\q1
\v 62 Dalam murka-Nya terhadap umat-Nya,
\q1 Dia membiarkan mereka dibunuh oleh pedang musuh.
\q1
\v 63 Para pemuda mati dalam kobaran perang
\q1 sehingga para pemudi kehilangan pasangan.
\q1
\v 64 Imam-imam terbunuh dalam perang
\q1 dan janda-janda mereka tidak dapat meratap.\x + \xo 78:64 \xt 1Sam 4:19-22\x*
\b
\q3
\v 65 Tetapi kemudian TUHAN bertindak!
\q3 Tindakan-Nya begitu mengejutkan,
\q3 bagai seorang yang tidur lelap tiba-tiba melonjak bangun
\q3 dan bagai pekik perang tentara yang berteriak nyaring karena pengaruh anggur.
\q3
\v 66 Allah menghantam mundur musuh-musuh-Nya
\q3 dan membuat mereka menanggung malu untuk selamanya.
\q1
\v 67 Namun sebagai pemimpin umat-Nya,
\q1 Allah tidak memilih keturunan Yusuf,
\q1 sehingga raja Israel tidak berasal dari suku Efraim.
\q1
\v 68 Yang dipilih-Nya adalah suku Yehuda,
\q1 dan yang dikasihi-Nya ialah Bukit Sion.
\q1
\v 69 Di sanalah Allah mendirikan rumah-Nya yang kudus,
\q1 di tempat tinggi sama seperti rumah-Nya yang di surga.
\q1 Tempat kediaman-Nya kokoh, sekokoh bumi ini,
\q1 berdiri teguh selama-lamanya.
\q3
\v 70 Allah memilih Daud, hamba-Nya,
\q3 seorang yang menggembalakan domba
\q3
\v 71 dan memelihara domba-domba betina yang menyusui.
\q3 TUHAN mengangkat dia menjadi gembala atas bangsa Israel,
\q3 umat milik-Nya sendiri.
\q3
\v 72 Maka dengan ketulusan hati dan segenap kemampuannya,
\q3 Daud memimpin dan menggembalakan rakyatnya.
\b