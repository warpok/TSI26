\c 37
\s Jangan iri pada keberhasilan orang jahat
\d Oleh Daud.
\q1
\v 1 Jangan panas hati
\q1 ketika orang lain berhasil dengan cara jahat.
\q1 Tak perlu iri
\q1 melihat orang yang sukses karena curang.
\q1
\v 2 Sebab orang jahat tidak akan bertahan lama.
\q1 Mereka bagaikan tanaman hijau yang segar sebentar
\q1 tetapi kemudian mengering dan mati.
\b
\q3
\v 3 Bergantunglah pada TUHAN
\q3 dan lakukanlah yang benar.
\q3 Hiduplah di negeri ini
\q3 dan tetaplah setia kepada TUHAN.
\q3
\v 4 Berbahagialah karena TUHAN,
\q3 maka Dia akan memenuhi keinginan hatimu.
\b
\q1
\v 5 Mintalah kehendak-Nya dalam setiap langkahmu.
\q1 Andalkanlah TUHAN, maka Dia yang akan bertindak.
\q1
\v 6 TUHAN akan menunjukkan dengan jelas bahwa engkau benar
\q1 hingga semua orang menyadarinya.
\q1 Dia akan menegakkan keadilan bagimu.
\b
\q3
\v 7 Tenangkan hatimu di hadapan TUHAN.
\q3 Nantikanlah Dia dengan sabar.
\q3 Jangan kesal karena orang yang berhasil dengan cara licik.
\q3
\v 8 Surutkan amarahmu.
\q3 Redakan kekesalanmu.
\q3 Jangan panas hati,
\q3 karena iri hati hanya akan membuatmu bertindak buruk.
\q3
\v 9 Ingatlah bahwa pelaku kejahatan akan dilenyapkan,
\q3 tetapi yang berharap kepada TUHAN akan mewarisi negeri.
\b
\q1
\v 10 Tunggulah saja.
\q1 Tak lama lagi orang jahat itu akan lenyap.
\q1 Meskipun dicari ke setiap sudut rumahnya,
\q1 dia sudah tidak ada.
\q1
\v 11 Sebaliknya, orang yang rendah hati
\q1 akan mewarisi negeri dan menikmati hidup damai.
\b
\q3
\v 12 Orang jahat menyusun rencana terhadap orang benar.
\q3 Hatinya bergolak dengan kebencian.
\q3
\v 13 Tetapi TUHAN menertawakan orang jahat itu
\q3 karena Dia tahu
\q3 bahwa akan tiba harinya mereka dibinasakan.
\b
\q1
\v 14 Seperti pembunuh menyiapkan pedang atau panah
\q1 sebelum mengincar korbannya,
\q1 demikianlah orang jahat bersiap-siap
\q1 untuk menghabisi orang yang miskin, yang sengsara,
\q1 dan yang hidupnya benar.
\q1
\v 15 Namun, kejahatan mereka seperti senjata makan tuan
\q1 yang akan berbalik menimpa mereka sendiri,
\q1 dan busur-busur mereka akan dipatahkan.
\b
\q1
\v 16 Lebih baik menjadi orang benar walaupun tidak banyak harta
\q1 daripada kaya raya tetapi bejat.
\q1
\v 17 Sebab kekuatan orang jahat akan dipatahkan,
\q1 tetapi orang benar dipelihara TUHAN.
\q1
\v 18 Hari demi hari
\q1 TUHAN memperhatikan orang yang hidupnya tak bercela.
\q1 Mereka akan tetap mewarisi negeri turun-temurun.
\q1
\v 19 Pada masa sulit
\q1 TUHAN tidak akan menelantarkan mereka.
\q1 Pada masa kelaparan
\q1 persediaan makanan mereka tetap melimpah.
\b
\q3
\v 20 Namun orang jahat pasti akan binasa.
\q3 Musuh-musuh TUHAN tidak akan bertahan lama.
\q3 Bagai padang rumput yang segar sebentar namun segera layu,
\q3 demikianlah mereka akan lenyap,
\q3 hilang seperti asap.
\b
\q1
\v 21 Orang jahat meminjam dan tidak mengembalikan,
\q1 sedangkan orang benar memberi dengan murah hati.
\q1
\v 22 Sungguh, orang yang diberkati TUHAN akan mewarisi negeri,
\q1 tetapi orang yang dikutuk TUHAN akan dilenyapkan.
\b
\q1
\v 23 TUHAN menjaga langkah hidup orang-orang
\q1 yang perbuatan-perbuatannya menyenangkan hati TUHAN.
\q1
\v 24 Karena itu sekalipun tersandung,
\q1 mereka tak akan sampai jatuh tergeletak
\q1 sebab tangan TUHAN menopang mereka.
\b
\q3
\v 25 Sejak masa mudaku sampai hari tuaku,
\q3 tak pernah aku melihat orang benar diabaikan TUHAN
\q3 dan tak pernah aku melihat anak cucu orang benar
\q3 mengemis demi sesuap nasi.
\q3
\v 26 Orang benar selalu murah hati.
\q3 Mereka akan memberi pinjaman,
\q3 dan anak cucunya akan menjadi berkat.
\b
\q1
\v 27 Maka jauhilah perbuatan jahat dan lakukanlah yang benar,
\q1 supaya engkau dan keturunanmu
\q1 hidup tenteram untuk seterusnya.
\q1
\v 28 Karena TUHAN mencintai keadilan
\q1 dan tak pernah menelantarkan umat-Nya yang setia.
\q1 Mereka akan selalu dipelihara.
\q1 Namun, orang jahat dan seluruh keturunannya akan dilenyapkan.
\q1
\v 29 Orang-orang benar akan mewarisi negeri
\q1 dan tinggal di dalamnya sampai selamanya.
\b
\q3
\v 30 Orang benar mengucapkan hal-hal bijak.
\q3 Perkataannya menyatakan keadilan.
\q3
\v 31 Ajaran-ajaran Allah ada di dalam hatinya
\q3 sehingga langkah hidupnya tak akan menyimpang.
\b
\q1
\v 32 Orang jahat mengintai orang benar,
\q1 mencari kesempatan untuk mematikan dia.
\q1
\v 33 Tetapi TUHAN tidak akan membiarkan orang benar itu jatuh ke tangan si jahat.
\q1 Saat orang benar diadili,
\q1 TUHAN tidak akan membiarkan dia kena hukuman.
\q3
\v 34 Nantikanlah TUHAN
\q3 dan tetaplah mengikuti jalan-Nya,
\q3 maka Dia akan melayakkan engkau untuk mewarisi negeri.
\q3 Engkau akan menyaksikan orang-orang jahat dilenyapkan.
\b
\q1
\v 35 Pernah aku melihat orang jahat berkembang makmur
\q1 bagaikan pohon tumbuh besar di tanah yang subur.
\q1
\v 36 Namun, tak lama kemudian dia lenyap!
\q1 Waktu aku lewat, aku mencarinya ke mana-mana,
\q1 ternyata dia sudah tidak ada.
\b
\q3
\v 37 Perhatikanlah orang-orang jujur
\q3 yang cinta damai dan hidup tak bercela.
\q3 Masa depan mereka selalu cerah.
\q3
\v 38 Sebaliknya, pemberontak dan pelaku kejahatan
\q3 pasti akan dimusnahkan.
\q3 Masa depan mereka hanyalah kebinasaan.
\b
\q1
\v 39 TUHAN menyelamatkan orang-orang yang hidupnya benar.
\q1 Dia menjadi pelindung mereka pada masa kesukaran.
\q1
\v 40 TUHAN senantiasa menolong dan meluputkan orang benar.
\q1 Maka sekarang, TUHAN pasti menolong mereka
\q1 dan melepaskan orang benar dari orang jahat
\q1 karena pada TUHANlah mereka berlindung.
\b