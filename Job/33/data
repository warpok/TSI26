\c 33
\s2 Elihu menjelaskan cara Allah berbicara kepada manusia
\q1
\v 1 Sekarang aku akan berbicara kepada engkau, Ayub.
\q1 Dengarkanlah aku.
\q1
\v 2 Perhatikanlah kata-kata yang aku ucapkan ini.
\q1
\v 3 Semuanya jujur dan tepat sesuai dengan apa yang ada dalam hatiku.
\q1
\v 4 Karena Roh Allahlah yang menjadikan aku.
\q1 Hembusan nafas-Nya memberiku kehidupan.
\q3
\v 5 Jawablah aku, jika engkau dapat.
\q3 Belalah dirimu dan berikan penjelasan.
\q3
\v 6 Engkau dan aku sama-sama buatan Allah.
\q3 Aku pun dijadikan dari tanah liat sepertimu.
\q3
\v 7 Jadi engkau tidak perlu takut.
\q3 Aku tidak akan menekanmu.
\b
\q1
\v 8 Semua pembicaraanmu tadi,
\q1 aku sudah mendengarnya dengan telingaku sendiri.
\q1
\v 9 Engkau berkata,
\q3 “Aku bersih.
\q3 Aku tidak melakukan pelanggaran apa pun.
\q3 Aku tidak bersalah.
\q3
\v 10 Allahlah yang mencari perkara denganku.
\q3 Dia menyerang aku seperti musuh.
\q3
\v 11 Dia menjepit kakiku dengan pasung
\q3 dan mengawasi ke mana pun aku pergi.”
\b
\q1
\v 12 Tetapi Ayub, engkau keliru.
\q1 Biar aku jelaskan alasannya.
\q1 Sebab Allah lebih besar daripada manusia.
\q1
\v 13 Jadi engkau tak bisa menuntut atau menyalahkan Dia
\q1 dengan menuduh-Nya tidak menjawab keluhanmu.
\q3
\v 14 Karena sebenarnya Allah sudah berbicara dengan berbagai cara,
\q3 hanya saja manusia tidak menyadarinya.
\q3
\v 15 Dia berbicara lewat mimpi
\q3 ketika orang tidur pada malam hari.
\q3
\v 16 Allah berbisik di telinganya
\q3 dan memberikan peringatan-peringatan yang jelas,
\q3
\v 17 supaya orang itu berhenti berbuat jahat
\q3 dan berbalik dari keangkuhannya.
\q1
\v 18 Dengan cara demikian Allah melindunginya dari kematian.
\b
\q1
\v 19 Allah juga berbicara melalui penyakit.
\q1 Itu salah satu bentuk teguran Allah,
\q3 yakni ketika orang terbaring kesakitan,
\q3
\v 20 hingga kehilangan selera makan,
\q3 bahkan tidak tergiur oleh makanan yang paling sedap,
\q3
\v 21 sampai badannya kurus kering dan tulangnya bertonjolan.
\q3
\v 22 Nyawanya sudah di ambang kematian.
\b
\q1
\v 23 Tetapi apabila seorang malaikat diutus dari surga
\q1 untuk menjadi penengah dan memberitahu cara memperbaiki hidupnya,
\q1
\v 24 malaikat itu akan mengasihaninya dan berkata,
\q3 “Jangan biarkan dia mati.
\q3 Terimalah tebusan untuk membayar nyawanya.”
\q1
\v 25 Maka orang itu akan sehat kembali.
\q1 Tubuhnya kembali segar bugar seperti remaja.
\q1
\v 26 Ketika dia berdoa kepada Allah, doanya akan didengar.
\q1 Allah akan menerima dia dengan sukacita
\q1 dan memperhitungkan dia sebagai orang benar.
\q1
\v 27 Kemudian dia akan bersaksi kepada orang-orang,
\q3 “Dahulu aku pernah berbuat dosa dan banyak ketidakadilan.
\q3 Namun Allah meringankan hukuman yang selayaknya aku terima.
\q3
\v 28 Allah melepaskan aku dari kematian
\q3 dan sekarang hidupku terang benderang.”
\b
\q1
\v 29 Sungguh, Ayub, itulah cara Allah berulang kali berbicara kepada manusia
\q1
\v 30 supaya jiwa mereka terhindar dari lubang kubur
\q1 sehingga mereka kembali menikmati cerahnya hidup.
\q3
\v 31 Perhatikanlah, Ayub. Dengarkanlah aku.
\q3 Masih ada lagi yang hendak aku katakan.
\q3
\v 32 Bila engkau hendak berbicara, bicaralah.
\q3 Karena aku pun berharap engkau bisa dibenarkan.
\q3
\v 33 Tetapi bila tidak ada,
\q3 diamlah sejenak, dan aku akan mengajarkan kebijaksanaan.