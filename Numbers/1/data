\tr \tc1 Simeon \tc2 59.300
\tr \tc1 Gad \tc2 45.650
\tr \tc1 Yehuda \tc2 74.600
\tr \tc1 Isakar \tc2 54.400
\tr \tc1 Zebulon \tc2 57.400
\tr \tc1 Efraim \tc2 40.500
